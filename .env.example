# A Neon/Supabase/Postgres connection string. Vercel's Neon integration supplies this.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Long random secret shared by the dashboard API and Windows agent.
INGEST_SECRET=replace-with-at-least-32-random-characters

# HTTP Basic Auth for the private dashboard.
DASHBOARD_USER=parent
DASHBOARD_PASSWORD=replace-with-a-long-random-password

# IANA timezone used to define "today" and render timestamps.
DISPLAY_TIME_ZONE=Asia/Jerusalem

# Generate these with: node scripts/control-setup.mjs generate --output .env.control.local
# Keep the generated private file out of Git. Apply the control DB migration
# separately before enabling the Windows service; see START-HERE.md.
CONTROL_ENCRYPTION_KEY=
CONTROL_POLICY_PRIVATE_KEY_PEM=
CONTROL_PARENT_TOTP_SECRET=

