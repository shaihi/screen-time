<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>ScreenTime.Agent.Tests</RootNamespace>
  </PropertyGroup>
  <!-- Platform-neutral agent logic, compiled directly so the tests run on any OS. -->
  <ItemGroup>
    <Compile Include="..\ScreenTime.Agent\AppNames.cs" Link="Agent\AppNames.cs" />
    <Compile Include="..\ScreenTime.Agent\ControlPipeClient.cs" Link="Agent\ControlPipeClient.cs" />
    <Compile Include="..\ScreenTime.Agent\AgentConfig.cs" Link="Agent\AgentConfig.cs" />
    <Compile Include="..\ScreenTime.Agent\AgentLifecycleTracker.cs" Link="Agent\AgentLifecycleTracker.cs" />
    <Compile Include="..\ScreenTime.Agent\MinuteAggregator.cs" Link="Agent\MinuteAggregator.cs" />
    <Compile Include="..\ScreenTime.Agent\Models.cs" Link="Agent\Models.cs" />
    <Compile Include="..\ScreenTime.Agent\PageTitles.cs" Link="Agent\PageTitles.cs" />
    <Compile Include="..\ScreenTime.Agent\UpdateChecker.cs" Link="Agent\UpdateChecker.cs" />
    <Compile Include="..\ScreenTime.Agent\UsageReminder.cs" Link="Agent\UsageReminder.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
